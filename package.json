    "typescript": "^6.0.3",
    "vite": "^7.0.0",
    "vitest": "^5.0.3",
    "web-push": "^3.6.7"
  },
  "dependencies": {
    "@fontsource/oswald": "^5.0.0",
    "@fontsource/unbounded": "^5.0.0"
